[Unit]
Description=Task dispatcher (hands queued tasks to OpenClaw agents)
After=network.target mission-control-api.service

[Service]
Type=simple
WorkingDirectory=@DEST@
Environment=ECOSYSTEM_HOME=@DEST@
Environment=HOME=/root
Environment=@PATH@
Environment=OPENCLAW_BIN=@OPENCLAW@
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ scripts/task-dispatcher.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
