[Unit]
Description=Mission Control API (agent task queue, 127.0.0.1:3001)
After=network.target

[Service]
Type=simple
WorkingDirectory=@DEST@/mission-control-api
Environment=ECOSYSTEM_HOME=@DEST@
Environment=HOME=/root
Environment=@PATH@
ExecStart=@NODE@ server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
